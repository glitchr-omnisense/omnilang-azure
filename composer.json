{
    "name": "omnilang/azure",
    "type": "library",
    "description": "Omnilang's Azure AI Translator, under any PHP host: texts and HTML translated (v3.0), languages detected, the supported languages, Office, HTML and text documents translated at once on the resource's custom domain - the key given by reference with its region, Azure's limits and data retention declared as data.",
    "keywords": [
        "azure",
        "azure-translator",
        "microsoft-translator",
        "translation",
        "machine-translation",
        "glossary",
        "document-translation",
        "framework-agnostic",
        "omnilang"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnilang-azure",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0",
        "omnisense/omnilang": "^1.0",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnilang\\Azure\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnilang\\Azure\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnisense": {
            "policy": "policy.json"
        },
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
